# ===== WhatsApp Cloud API (Meta) — used by api/inquiry.js and api/whatsapp-webhook.js =====
# Set these in your host (Vercel > Project > Settings > Environment Variables), then redeploy.
# SERVER-SIDE ONLY: never prefix any of these with VITE_ (that would expose them in the browser).

# Permanent System User token (Business Settings > Users > System users). NOT the 24-hour test token from API Setup.
WHATSAPP_TOKEN=
# WhatsApp Manager > API Setup > "Phone number ID" (a long number; this is NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you invent. Paste the same value into Meta > WhatsApp > Configuration > Webhook > Verify token
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Lets the webhook reject fake calls that don't come from Meta.
WHATSAPP_APP_SECRET=
# Graph API version (update occasionally; Meta retires old versions after ~2 years)
WHATSAPP_API_VERSION=v23.0

# ----- Approved message templates (create in WhatsApp Manager > Message templates, category: Utility) -----
# Template 1 name: inquiry_received   (sent to the customer)
# Body: Hi {{1}}, thank you for contacting Salitous Homes! We've received your details and our design team will reach you shortly. Email: info@salitoushomes.com
WHATSAPP_TEMPLATE=inquiry_received
WHATSAPP_TEMPLATE_LANG=en

# Template 2 name: team_new_lead   (sent to your team)
# Body: New Salitous Homes lead received.
#
# Name: {{1}}
# Phone: {{2}}
# Email: {{3}}
# Project type: {{4}}
# Message: {{5}}
#
# Please contact this customer as soon as possible.
WHATSAPP_TEAM_TEMPLATE=team_new_lead

# Who gets the lead alerts: digits with country code, comma-separated for several people.
# Must be DIFFERENT from the business number the website sends from (a number cannot message itself).
TEAM_WHATSAPP_NUMBER=
DEFAULT_COUNTRY_CODE=91

# ----- Auto-reply when a customer messages the business number directly -----
# Set to "off" to disable the bot reply (the team alert still fires).
AUTO_REPLY=on
# Optional custom reply. {name} is replaced with the customer's WhatsApp profile name. Leave empty for the default.
AUTO_REPLY_TEXT=

# ----- Optional but recommended: Upstash Redis (free tier) so the "once per customer" limits survive serverless cold starts -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
